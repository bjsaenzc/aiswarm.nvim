#!/usr/bin/env bash
# Push one control event into a running Neovim. Set: export AISWARM_ON_EVENT=aiswarm-push
# The plugin writes v:servername into <root>/nvim.server when it starts.
root="${AISWARM_ROOT:-$PWD/.aiswarm}"
srv=$(head -1 "$root/nvim.server" 2>/dev/null) || exit 0
[ -n "$srv" ] || exit 0
# vimscript single-quoted string: only ' needs escaping, as ''
root=$(cd "$root" 2>/dev/null && pwd -P) || exit 0
escaped_root=${root//\'/\'\'}
payload=${1//\'/\'\'}
# Deliver to the canonical callback in the registered editor.
nvim --server "$srv" --remote-expr \
  "luaeval(\"require('aiswarm').on_event_json(_A[1], _A[2])\", ['$payload', '$escaped_root'])" >/dev/null 2>&1 || true
